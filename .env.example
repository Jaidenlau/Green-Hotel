# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill it in. Never commit .env.local.
# ---------------------------------------------------------------------------

# The public address of the site, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://greenhotel.example.com

# --- Airbnb calendar sync ---------------------------------------------------
# Airbnb > Calendar > Availability > Connect calendars > Export calendar.
# Copy the .ics link it gives you and paste it here. One per room.
AIRBNB_ICAL_OCEAN=
# One per placeholder room, needed only once that room goes on sale.
AIRBNB_ICAL_ROOM_2=
AIRBNB_ICAL_ROOM_3=
AIRBNB_ICAL_ROOM_4=

# Optional. If set, the calendar feed Airbnb imports from us requires
# ?key=<this value>, so the booking dates aren't publicly readable.
CALENDAR_FEED_SECRET=

# --- Payments (Stripe) ------------------------------------------------------
# Leave blank to run the site in enquiry-only mode: the calendar still works,
# but guests send a message instead of paying online.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) ---------------------------------------------------------
# Used for the contact form and to tell the owner about new bookings.
RESEND_API_KEY=
MAIL_FROM="Green Hotel <bookings@greenhotel.example.com>"
OWNER_EMAIL=

# --- Shown publicly in the footer and on the contact page -------------------
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
